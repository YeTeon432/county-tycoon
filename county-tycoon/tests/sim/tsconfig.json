{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "../..",
    "outDir": "../.build",
  },
  "include": ["../../assets/scripts/core/sim/**/*.ts", "./**/*.ts"],
  "exclude": ["../../assets/scripts/core/sim/mock.ts"]
}
