CCEffect %{
  techniques:
  - name: foliage
    passes:
    - vert: district-vs:vert
      frag: district-fs:frag
      embeddedMacros: { LEAVES: true }
      properties: &surface
        mainColor: { value: [1, 1, 1, 1], editor: { type: color } }
  - name: glass
    passes:
    - vert: district-vs:vert
      frag: district-fs:frag
      properties: *surface
  - name: housing
    passes:
    - vert: district-vs:vert
      frag: district-fs:frag
      embeddedMacros: { HOUSING: true }
      properties: *surface
}%

CCProgram district-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/fog-vs>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  #if HOUSING
    out vec2 v_finishSun;
    out vec3 v_model;
  #endif
  out vec3 v_world;
  out vec3 v_normal;
  out vec3 v_color;

  vec4 vert () {
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    #if LEAVES
      // 世界坐标保持相邻树木的风向一致；仅弯动绿色树冠，树池和主干固定。
      float leaf = smoothstep(0.025, 0.12, a_color.g - a_color.r);
      float bend = leaf * smoothstep(0.14, 1.24, world.y);
      float phase = dot(world.xz, vec2(0.78, 0.48));
      float gust = sin(1.63 * cc_time.x + phase) + 0.41 * sin(2.93 * cc_time.x + 1.7 * phase + world.y);
      world.xz += vec2(0.032, 0.017) * bend * gust;
    #endif
    #if HOUSING
      // 建筑只绕地块中心整转 90 度。选本朝向的日光可见度，转相机时保持固定。
      vec2 axis = normalize(cc_matWorld[0].xz);
      vec4 turns = max(vec4(axis.x, -axis.y, -axis.x, axis.y), vec4(0.0));
      float packedFinish = floor(a_color.a * 255.0 + 0.5) - 192.0;
      vec4 visibility = mod(floor(packedFinish / vec4(1.0, 2.0, 4.0, 8.0)), 2.0);
      v_model = a_position;
      v_finishSun = vec2(floor(packedFinish / 16.0), dot(turns, visibility));
      if (v_finishSun.x < -4.5) {
        float phase = dot(world.xz, vec2(0.78, 0.48));
        world.xz += vec2(0.014, 0.008) * sin(1.63 * cc_time.x + phase) * smoothstep(0.15, 0.85, a_position.y);
      }
    #endif
    v_world = world.xyz;
    v_normal = mat3(cc_matWorldIT) * a_normal;
    v_color = a_color.rgb;
    CC_TRANSFER_FOG(world);
    return cc_matViewProj * world;
  }
}%

CCProgram district-fs %{
  #pragma extension([GL_OES_standard_derivatives, __VERSION__ < 110])
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/fog-fs>
  #include <legacy/output-standard>
  uniform Surface { vec4 mainColor; };
  #if HOUSING
    in vec2 v_finishSun;
    in vec3 v_model;
  #endif
  in vec3 v_world;
  in vec3 v_normal;
  in vec3 v_color;

  vec4 frag () {
    vec3 n = normalize(v_normal);
    vec3 sun = -cc_mainLitDir.xyz;
    float light = max(dot(n, sun), 0.0);
    #if LEAVES
      vec3 tint = mix(vec3(0.78, 0.84, 0.84), vec3(1.14, 1.10, 0.94), light);
      vec3 rgb = v_color * tint * (0.97 + 0.08 * n.y);
    #elif HOUSING
      vec3 eye = normalize(cc_matViewInv[2].xyz);
      float direct = light * v_finishSun.y;
      vec3 rgb = v_color * (vec3(0.84, 0.88, 0.91) + vec3(0.34, 0.29, 0.22) * direct);
      // 暖砖楼梯间只在靠近时显出灰缝，远景按像素宽度淡出，避免闪烁。
      #if __VERSION__ >= 300 || defined(GL_OES_standard_derivatives)
      vec3 modelNormal = abs(cross(dFdx(v_model), dFdy(v_model)));
      vec2 facadeUV = vec2(modelNormal.x > modelNormal.z ? v_model.z : v_model.x, v_model.y);
      if (v_finishSun.x > -4.5 && v_finishSun.x < -0.5) {
        vec2 uv = modelNormal.y > max(modelNormal.x, modelNormal.z) ? v_model.xz : facadeUV;
        vec2 repeats = vec2(4.0, 19.0);
        if (v_finishSun.x < -3.5) repeats = vec2(16.0, 11.0);
        else if (v_finishSun.x < -2.5) repeats = vec2(8.0, 1.0);
        else if (v_finishSun.x < -1.5) repeats = vec2(4.0, 6.0);
        vec2 grid = uv * repeats;
        vec2 footprint = fwidth(grid);
        if (v_finishSun.x < -3.5 || (v_finishSun.x > -2.5 && v_finishSun.x < -1.5))
          grid.x += 0.5 * mod(floor(grid.y), 2.0);
        vec2 dist = 0.5 - abs(fract(grid) - 0.5);
        vec2 joint = (1.0 - smoothstep(vec2(0.012), vec2(0.048) + footprint * 0.5, dist))
                   * (1.0 - smoothstep(vec2(0.25), vec2(0.85), footprint));
        if (v_finishSun.x < -2.5 && v_finishSun.x > -3.5) joint.y = 0.0;
        rgb *= 1.0 - 0.17 * max(joint.x, joint.y);
      }
      if (v_finishSun.x > 1.5 && v_finishSun.x < 2.5) {
        vec2 brick = facadeUV * vec2(13.0, 33.0);
        vec2 pixel = fwidth(brick);
        brick.x += 0.5 * mod(floor(brick.y), 2.0);
        vec2 edge = 0.5 - abs(fract(brick) - 0.5);
        vec2 mortar = (1.0 - smoothstep(vec2(0.014), vec2(0.045) + pixel * 0.5, edge))
                    * (1.0 - smoothstep(vec2(0.25), vec2(0.95), pixel));
        rgb = mix(rgb, vec3(0.82, 0.78, 0.70), 0.24 * max(mortar.x, mortar.y));
      }
      #endif
      if (abs(v_finishSun.x) < 0.5) {
        vec3 reflected = reflect(-eye, n);
        float sky = smoothstep(-0.65, 0.34, reflected.y);
        float fresnel = pow(1.0 - max(dot(n, eye), 0.0), 3.0);
        vec3 environment = mix(vec3(0.28, 0.36, 0.35), vec3(0.67, 0.79, 0.82), sky);
        rgb = mix(rgb, environment, 0.15 + 0.42 * fresnel);
      } else if (abs(v_finishSun.x - 1.0) < 0.5) {
        float highlight = pow(max(dot(n, normalize(sun + eye)), 0.0), 20.0);
        rgb += vec3(0.32, 0.30, 0.24) * highlight * direct;
      }
    #else
      vec3 eye = normalize(cc_matViewInv[2].xyz);
      vec3 ray = reflect(-eye, n);
      float edge = pow(1.0 - clamp(dot(eye, n), 0.0, 1.0), 2.4);
      float sky = smoothstep(-0.65, 0.16, ray.y + 0.10 * v_world.y);
      vec3 reflection = mix(vec3(0.40, 0.56, 0.62), vec3(0.83, 0.91, 0.94), sky);
      float glint = pow(max(dot(reflect(-sun, n), eye), 0.0), 24.0);
      vec3 rgb = mix(v_color * (0.86 + 0.16 * light), reflection, 0.17 + 0.42 * edge);
      rgb += vec3(0.17, 0.14, 0.09) * glint;
    #endif
    vec4 color = vec4(SRGBToLinear(rgb * mainColor.rgb), 1.0);
    CC_APPLY_FOG(color, v_world);
    return CCFragOutput(color);
  }
}%
