CCEffect %{
  techniques:
  - passes:
    - vert: landscape-vs:vert
      frag: landscape-fs:frag
      properties:
        mainTexture: { value: grey }
  - passes:
    - vert: highlands-vs:vert
      frag: highlands-fs:frag
}%

CCProgram meadow-color %{
  float meadowLight (vec2 p) {
    return 0.50 + 0.26 * sin(p.x * 0.82 + sin(p.y * 0.67))
                + 0.24 * sin(p.y * 1.04 - p.x * 0.31);
  }
  vec3 meadowColor (float lightLevel) {
    return mix(vec3(0.53, 0.68, 0.46), vec3(0.70, 0.77, 0.51),
               smoothstep(0.12, 0.88, lightLevel));
  }
}%

CCProgram highlands-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/fog-vs>
  #include <meadow-color>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  out vec3 v_color;
  out vec3 v_highlandWorld;
  vec4 vert () {
    vec3 normal = normalize(mat3(cc_matWorldIT) * a_normal);
    float sun = dot(normal, -cc_mainLitDir.xyz);
    float shade = 0.83 + 0.26 * sun;
    v_color = mix(meadowColor(meadowLight(a_position.xz)), a_color.rgb * shade, a_color.a);
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    v_highlandWorld = world.xyz;
    CC_TRANSFER_FOG(world);
    return cc_matViewProj * world;
  }
}%

CCProgram highlands-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <legacy/fog-fs>
  in vec3 v_color;
  in vec3 v_highlandWorld;
  vec4 frag () {
    vec4 color = vec4(SRGBToLinear(v_color), 1.0);
    CC_APPLY_FOG(color, v_highlandWorld);
    return CCFragOutput(color);
  }
}%

CCProgram landscape-vs %{
  precision highp float;
  #include <meadow-color>
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  #include <legacy/fog-vs>
  in vec3 a_position;
  in vec2 a_texCoord;
  // Local tile UV, eight neighbouring land bits, and surface type.
  in vec4 a_color;
  out vec2 v_atlas;
  out vec4 v_tile;
  out vec3 v_field;
  out vec4 v_banks;
  out vec4 v_corners;

  vec4 bits (float value) {
    return mod(floor(value / vec4(1.0, 2.0, 4.0, 8.0)), 2.0);
  }

  vec4 vert () {
    vec2 p = a_position.xz;
    v_field = vec3(p, meadowLight(p));
    v_atlas = a_texCoord;
    v_tile = a_color;
    float mask = floor(a_color.z * 255.0 + 0.5);
    v_banks = bits(mask);
    v_corners = bits(floor(mask / 16.0));
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    CC_TRANSFER_FOG(world);
    return cc_matViewProj * world;
  }
}%

CCProgram landscape-fs %{
  precision highp float;
  #include <meadow-color>
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  #include <legacy/fog-fs>
  in vec2 v_atlas;
  in vec4 v_tile;
  in vec3 v_field;
  in vec4 v_banks;
  in vec4 v_corners;
  uniform sampler2D mainTexture;

  vec3 meadow () {
    return meadowColor(v_field.z);
  }

  float shoreDistance () {
    vec2 p = v_tile.xy;
    vec4 edges = mix(vec4(2.0), vec4(p, 1.0 - p), v_banks);
    vec2 inset = vec2(0.31) - min(edges.xy, edges.zw);
    float d = 0.31 - length(max(inset, 0.0)) - min(max(inset.x, inset.y), 0.0);
    vec4 corners = vec4(length(p), length(vec2(1.0-p.x, p.y)),
                        length(1.0-p), length(vec2(p.x, 1.0-p.y)));
    corners = mix(vec4(2.0), corners, v_corners);
    return min(d, min(min(corners.x, corners.y), min(corners.z, corners.w)));
  }

  vec3 water (bool pond) {
    vec2 p = v_field.xy;
    float drift = cc_time.x * 0.72;
    float shore = shoreDistance() + 0.021 * sin(p.x * 9.0 + p.y * 11.0);
    vec3 deep = pond ? vec3(0.22, 0.61, 0.59) : vec3(0.22, 0.58, 0.72);
    vec3 shallow = pond ? vec3(0.55, 0.78, 0.64) : vec3(0.52, 0.80, 0.82);
    vec3 surface = mix(shallow, deep, smoothstep(0.10, 0.64, shore));
    // Short wind ripples in map space; highlights carry across tile boundaries.
    float crest = sin(p.x * 11.0 + p.y * 17.0 + 1.2 * sin(p.x * 3.5) - drift * 1.8);
    float rippleGroup = sin(p.x * 8.0 - p.y * 6.0 + 1.7 * sin(p.y * 4.0) + drift);
    surface += vec3(0.14, 0.15, 0.12) * smoothstep(0.86, 0.99, crest)
             * smoothstep(0.28, 0.85, rippleGroup) * smoothstep(0.10, 0.24, shore);
    vec3 bank = mix(meadow(), vec3(0.78, 0.73, 0.54), smoothstep(0.01, 0.08, shore));
    return mix(bank, surface, smoothstep(0.09, 0.12, shore));
  }

  vec4 frag () {
    vec3 tile = texture(mainTexture, v_atlas).rgb;
    // Bridge decking keeps its atlas artwork; blue texels are the water below it.
    if (v_tile.w > 0.30 && (v_tile.w < 0.9 || tile.b > tile.r + 0.08)) {
      tile = water(v_tile.w > 0.5 && v_tile.w < 0.9);
    } else if (v_tile.w > 0.15 && v_tile.w < 0.30) {
      float margin = shoreDistance() + 0.06 * sin(v_field.x * 5.0 + v_field.y * 7.0);
      vec3 scree = vec3(0.64, 0.61, 0.51) + 0.42 * (tile.g - 0.61);
      tile = mix(meadow(), scree, smoothstep(0.02, 0.38, margin));
    } else if (v_tile.w > 0.05 && v_tile.w < 0.15) {
      // Feather the forest floor into the meadow under each group of trees.
      float canopy = 1.0 - smoothstep(0.21, 0.55, length(v_tile.xy - 0.5));
      tile = meadow() * (1.0 - 0.10 * canopy) + (tile.g - 0.65) * 0.12;
    } else {
      float grass = smoothstep(0.09, 0.27, tile.g - max(tile.r, tile.b));
      vec3 blades = meadow() + (tile.g - 0.82) * vec3(0.52, 0.58, 0.43);
      tile = mix(tile, blades, grass);
    }
    vec4 color = vec4(SRGBToLinear(tile), 1.0);
    CC_APPLY_FOG(color, vec3(v_field.x, 0.0, v_field.y));
    return CCFragOutput(color);
  }
}%
