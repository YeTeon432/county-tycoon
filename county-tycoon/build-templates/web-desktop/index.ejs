<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>我在县城当县长</title>
  <link rel="stylesheet" href="<%= cssUrl %>">
  <style>
    body {
      display: grid;
      place-items: center;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      background: #26362d;
    }

    #startup {
      position: fixed;
      inset: 0;
      z-index: 10;
      overflow: auto;
      display: grid;
      place-items: center;
      box-sizing: border-box;
      padding: 22px;
      color: #304737;
      background-color: #faf4e5;
      background-image: linear-gradient(30deg, transparent 49.6%, #7c866815 50%, transparent 50.4%),
                        linear-gradient(-30deg, transparent 49.6%, #7c866815 50%, transparent 50.4%);
      background-size: 72px 42px;
      font-family: system-ui, sans-serif;
    }
    .loading-town { width: min(100%, 640px); text-align: center; }
    .loading-town h1 {
      margin: 0;
      color: #304737;
      font: 800 clamp(28px, 5.2vw, 54px)/1.18 "Songti SC", "Noto Serif CJK SC", serif;
      letter-spacing: .06em;
    }
    .loading-town img {
      display: block;
      width: min(100%, 510px);
      height: clamp(110px, 38vh, 295px);
      object-fit: contain;
      margin: clamp(12px, 3vh, 28px) auto;
      filter: drop-shadow(0 9px 4px #35483222);
    }
    .load-details { max-width: 360px; margin: auto; }
    .load-caption { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    #startup-status { text-align: left; font-size: 15px; font-weight: 600; }
    #load-count { font: 600 14px/1.4 ui-monospace, monospace; white-space: nowrap; }
    #load-track { height: 9px; overflow: hidden; border: 1px solid #455c44; border-radius: 3px; background: #e5e5cf; margin-top: 10px; }
    #load-fill { height: 100%; width: 0; background: #527449; transition: width .15s ease-out; }
    #load-track:not([aria-valuenow]) #load-fill { width: 30%; animation: loading 1.5s ease-in-out infinite alternate; }
    @keyframes loading { to { transform: translateX(230%); } }
    @media (prefers-reduced-motion: reduce) {
      #load-track #load-fill { animation: none; transition: none; }
    }
    #startup button { margin-top: 15px; cursor: pointer; border: 1px solid #526249; color: #304737; background: #fff9eb; border-radius: 5px; padding: 7px 15px; font: inherit; }
    #startup [hidden] { display: none; }

    #GameDiv {
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    #GameCanvas {
      display: block;
      touch-action: none;
    }
  </style>
</head>
<body>
  <div id="startup">
    <section class="loading-town" aria-labelledby="game-title">
      <h1 id="game-title">我在县城当县长</h1>
      <img src="./startup-town.webp" alt="" width="833" height="520">
      <div class="load-details">
        <div class="load-caption">
          <span id="startup-status" role="status">正在启动游戏引擎…</span>
          <span id="load-count" aria-hidden="true"></span>
        </div>
        <div id="load-track" role="progressbar" aria-label="城镇资源加载进度" aria-valuemin="0"><div id="load-fill"></div></div>
        <button type="button" hidden onclick="location.reload()">重新加载</button>
      </div>
    </section>
  </div>
  <div id="GameDiv" cc_exact_fit_screen="false">
    <div id="Cocos3dGameContainer">
      <canvas id="GameCanvas" tabindex="0" aria-label="我在县城当县长"></canvas>
    </div>
  </div>
  <script>
    const startup = document.getElementById('startup');
    const statusText = document.getElementById('startup-status');
    const retry = startup.querySelector('button');
    const track = document.getElementById('load-track');
    const fill = document.getElementById('load-fill');
    const count = document.getElementById('load-count');
    let failed = false;
    let slowTimer;
    function markActivity() {
      retry.hidden = true;
      clearTimeout(slowTimer);
      slowTimer = setTimeout(() => { retry.hidden = false; }, 20000);
    }
    markActivity();

    function startupFailed(error) {
      if (failed) return;
      failed = true;
      clearTimeout(slowTimer);
      console.error('[城镇加载]', error);
      statusText.textContent = '加载失败，请重新加载。';
      count.textContent = '';
      track.hidden = true;
      retry.hidden = false;
    }

    async function loadTownResources(cc) {
      const { resources, JsonAsset, ImageAsset, Prefab, Material } = cc;
      const assets = [];
      function include(directory, type, accept = () => true) {
        const infos = resources.getDirWithPath(directory, type).filter(info => accept(info.path));
        if (!infos.length) throw new Error('缺少城镇资源：' + directory);
        for (const info of infos) assets.push({ path: info.path, type });
      }
      include('config', JsonAsset);
      include('art', JsonAsset);
      include('art', ImageAsset);
      include('ui/icons', ImageAsset);
      include('models3d', Prefab);
      include('models3d', Material, path => /^models3d\/[^/]+$/.test(path));

      let loaded = 0;
      function showProgress() {
        if (failed) return;
        markActivity();
        track.setAttribute('aria-valuenow', loaded);
        count.textContent = loaded + ' / ' + assets.length;
        fill.style.width = (loaded * 100 / assets.length) + '%';
      }
      statusText.textContent = '正在加载城镇资源…';
      track.setAttribute('aria-valuemax', assets.length);
      showProgress();
      // 使用游戏本身的资源缓存。每项在解码及其依赖就绪后计入进度。
      await Promise.all(assets.map(({ path, type }) => new Promise((resolve, reject) => {
        resources.load(path, type, (error, asset) => {
          if (error || !asset) { reject(error || new Error(path)); return; }
          loaded++;
          showProgress();
          resolve();
        });
      })));
      if (!failed) statusText.textContent = '正在绘制城镇…';
    }
    const frame = document.getElementById('GameDiv');
    const designWidth = <%= previewWidth %>;
    const designHeight = <%= previewHeight %>;

    // 先更新容器，再由 Cocos 的 resize 监听器更新画布。
    function fitGameFrame() {
      const scale = Math.min(window.innerWidth / designWidth, document.body.clientHeight / designHeight);
      frame.style.width = Math.round(designWidth * scale) + 'px';
      frame.style.height = Math.round(designHeight * scale) + 'px';
    }

    fitGameFrame();
    window.addEventListener('resize', fitGameFrame);
    frame.addEventListener('contextmenu', (event) => event.preventDefault());
  </script>
  <% if (polyfillsBundleFile) { %>
  <script src="<%= polyfillsBundleFile %>" onerror="startupFailed()"></script>
  <% } %>
  <script src="<%= systemJsBundleFile %>" onerror="startupFailed()"></script>
  <script src="<%= importMapFile %>" type="systemjs-importmap"></script>
  <script>
    Promise.resolve().then(() => System.import('cc')).then(cc => {
      const { director, Director, game, settings, ResolutionPolicy } = cc;
      markActivity();
      statusText.textContent = '正在读取游戏配置…';
      director.once('town-load-error', startupFailed);
      const ready = name => new Promise(resolve => director.once(name, resolve));
      Promise.all([ready('town-ready'), ready('town-art-ready')]).then(() => {
        director.once(Director.EVENT_AFTER_DRAW, () => {
          if (failed) return;
          clearTimeout(slowTimer);
          startup.remove();
        });
      });
      game.onPostProjectInitDelegate.add(async () => {
        try {
          await loadTownResources(cc);
        } catch (error) {
          startupFailed(error);
          throw error;
        }
      });
      game.onPostBaseInitDelegate.add(() => {
        settings.overrideSettings('screen', 'landscapeWebLayout', true);
        settings.overrideSettings('screen', 'designResolution', {
          width: designWidth,
          height: designHeight,
          policy: ResolutionPolicy.FIXED_WIDTH,
        });
      });
      return System.import('<%= indexJsName.startsWith("./") ? indexJsName : "./" + indexJsName %>');
    }).catch(startupFailed);
  </script>
</body>
</html>
